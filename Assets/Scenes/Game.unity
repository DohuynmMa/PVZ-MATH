  soundVolumeBar: {fileID: 2071786681}
  musicVolumeBar: {fileID: 1520460534}
  voiceVolumeBar: {fileID: 1119840651}
  levelList:
  - {fileID: 3305872933263581029}
  - {fileID: 4809698719672231579}
  - {fileID: 4809698719059622180}
  levelPageTemp: 0
  levelPages:
  - {fileID: 522078269}
  - {fileID: 1948704947}
  nextLevelPageButton: {fileID: 90411321}
  lastLevelPageButton: {fileID: 1133288230}
  levelListBarrier: []
  setNameUI: {fileID: 8538747144315290001}
  inputNameArea: {fileID: 6146506617656670390}
  inputTips: {fileID: 821966909141204220}
  news:
  - "\u8FD1\u671F,\u591A\u540D\u5E02\u6C11\u8BD5\u56FE\u5BFB\u627E\u6682\u505C\u952E--\n\n\u5F88\u53EF\u60DC,\u8BE5\u7CFB\u7EDF\u5E76\u6CA1\u6709\u6682\u505C\u670D\u52A1:("
  - "BP\u597D\u591A...\u6839\u672C\u7528\u4E0D\u5B8C....\n\n\u53EF\u662F...\u6211\u53EA\u6709\u4E24\u53EA\u624B..\n\n\u5E02\u6C11A:\u8FD9\u5C31\u597D\u6BD4\u4F60\u6709\u4E00\u5806\u60F3\u6CD5,\n\u5374\u65E0\u6CD5\u7ACB\u9A6C\u5168\u90E8\u5B9E\u73B0."
  - "\u603B\u6709\u4EBA\u4F1A\u5C06\u4E00\u4E2A\u6570\u9664\u4EE50\n\n\u6216\u8BB8\u4ED6\u662F\u65E0\u610F\u7684,\u4E5F\u6709\u53EF\u80FD\u662F\u6545\u610F\u7684.\n\n\u8BE5\u7CFB\u7EDF\u89C4\u907F\u4E86\u8FD9\u4E00\u70B9."
  - "\u5E02\u6C11B\u4E0D\u5C0F\u5FC3\u5F97\u5230\u4E86\u4E00\u4E2A\u5C0F\u6570\u7684LW.\n\n\u4ED6\u5C1D\u8BD5\u5C06\u4E00\u5F20[\u4E2D\u62EC\u53F7]\u7684T\n\u653E\u5728\u8BE5\u683C\u5B50\u4E0A.\n\n\u8FD9\u4E2ALW\u7ADF\u7136\u5947\u8FF9\u822C\u5730\u53D6\u6574\u4E86?"
  - "\u6700\u8FD1\u603B\u6709\u5E02\u6C11\u83AB\u540D\u5176\u5999\u7761\u7740\n\u672C\u7CFB\u7EDF\u547C\u5401\u5404\u4F4D\u7231\u62A4\u8EAB\u4F53."
  - "WTF???\u53C8\u51FA\u4E86\u4E00\u4E2ABUG?"
  - "\u5E02\u6C11C\u6709\u4E00\u4E2A\u5168\u65B0\u7684\u53D1\u73B0,\n\u5C06\u4F60\u73A9\u6E38\u620F\u7684\u65F6\u95F4+1
    -1\n\u4F60\u4FBF\u5F97\u5230\u4E86\u4F60\u73A9\u6E38\u620F\u7684\u65F6\u95F4."
  - "\u4ECA\u5929\u4F60\u5B66\u4E60\u4E86\u5417?\n\n\u53CD\u6B63\u6211\u6CA1\u6709."
  - "\u4E0D\u5FC5\u62C5\u5FC3,\u73B0\u5B9E\u4E2D\u7684\u4F60\u53EA\u662F\u5728\u7761\u89C9.\n\n\u4F60\u7684\u610F\u8BC6\u4E0E\u6211\u8FDE\u63A5\u4E86...."
  - "\u5982\u6B64\u719F\u6089\u7684\u73A9\u6CD5,\u8FD9\u4F7F\u4F60\u56DE\u5FC6\u8D77\u4E86\u8FC7\u5F80..."
  - "\u6B22\u8FCE\u8BA2\u9605PVZ-MATH\u671F\u520A~\n\n\u7531\u4E8E\u60A8\u4E00\u76F4\u5904\u4E8E\u660F\u7761,\u8FD9\u91CC\u4F1A\u4E3A\u60A8\u6301\u7EED\n\u64AD\u62A5\u5916\u754C\u6700\u65B0\u65B0\u95FB."
  - "\u5982\u679C\u4F60\u8FD8\u662F\u5C0F\u670B\u53CB,\u8BF7\u4E0D\u7528\u62C5\u5FC3\n\n\u672C\u7CFB\u7EDF\u5141\u8BB8\u4EFB\u610F\u5E74\u9F84\u5927\u5C0F\u7528\u6237\u4F7F\u7528~\n\n\u63D0\u524D\u4E86\u89E3\u67D0\u4E9B\u4E1C\u897F\u6216\u8BB8\u4E5F\u4E0D\u9519?>..."
  - ???
  - "\u8FD1\u671F\u591A\u4F4D\u5E02\u6C11\u76EE\u7779\u5230\u4E00\u4E2A\u7075\u5F02\u73B0\u8C61:\n\u6709\u540D\u4EBA\u7C7B\u5728\u62C9\u7740\u706B\u8F66\u8DD1\u6B65\n\u7A76\u7ADF\u662F\u9053\u5FB7\u7684\u6CA6\u4E27?\u8FD8\u662F\u4EBA\u6027\u7684\u626D\u66F2?\nPVZ-MATH\u4E13\u6848\u7EC4\u4F1A\u6301\u7EED\u8C03\u67E5\u8BE5\u4E8B\u4EF6...."
  - "\u554A\u5BF9,\u5185\u5BB9\u5C31\u53EA\u6709\u8FD9\u4E48\u591A...\n\u4E0D\u8BF4\u4E86...\u4FEEBUG\u53BB\u4E86...QWQ"
  - "\u7528\u6237F\u8BA4\u4E3A\u53EF\u4EE5\u5229\u7528\"\u968F\u673A\"\u6765\u901A\u5173.\n\n\u662F\u7684,\u6240\u4EE5\u73B0\u5B9E\u4E2D,\u4F60\u8499\u5BF9\u8FC7\u51E0\u4E2A\u9009\u62E9\u9898\u5462?"
  - "\u4E00\u65E6P\u5728\u653B\u51FBT,\u5B83\u4FBF\u4F1A\u505C\u6B62\u79FB\u52A8,\u4F3C\u4E4E\u53EF\u4EE5\u5229\u7528\u8FD9\u4E2A\u6280\u5DE7\u964D\u4F4E\u5931\u8D25\u7387?"
